# 复制为 .env 后填写。只填你要用的提供商；没有密钥的模型会被路由自动跳过。
TELEGRAM_BOT_TOKEN=
# 你的 Telegram 数字 ID（发消息给 @userinfobot 获得）；不填则 bot 不认任何人为主人
OWNER_TELEGRAM_ID=
# Telegram 走的代理，例如 http://127.0.0.1:7890；不需要就留空
TELEGRAM_PROXY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# 百炼 Token Plan；也可直接使用已有的系统/用户环境变量。
BAILIAN_API_KEY=
BAILIAN_BASE_URL_OAI=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 日志级别，例如 info / debug / aglibot=debug
RUST_LOG=info
